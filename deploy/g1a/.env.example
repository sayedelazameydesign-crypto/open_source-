# g1a Cloud deploy — environment template.
# Copy these keys into your platform's secret store (Render/Fly/Railway/...).
# NEVER commit real values; tokens and keys stay server-side only.

# --- Required ---------------------------------------------------------------
# Bearer token for the public platform API (/runs, /artifacts, /ledger, ...).
# Guarded endpoints answer 503 until this is set.
CELA_API_TOKEN=

# Separate token for the private /cela/v1 namespace. Must differ from the above.
CELA_PRIVATE_API_TOKEN=

# --- Code execution (fail-closed for this hosted bundle) --------------------
# `disabled` refuses every code-exec request via DisabledBackend — untrusted
# code never runs on the cloud host. To run code you must explicitly opt into
# an isolated microVM backend instead:
#   CELA_CODE_EXEC_MODE=production
#   CELA_CODE_EXEC_BACKEND=e2b        # or firecracker
# `production` without a backend refuses to boot (ADR-0005); there is no
# silent fall back to the local subprocess backend.
CELA_CODE_EXEC_MODE=disabled

# --- Durable storage (recommended for any real cloud host) ------------------
# Local : sqlite:///./cela_runs.db
# Cloud : postgresql://user:pass@host:5432/postgres   (needs the `distributed` extra)
CELA_RUN_STORE_URL=

# --- Model provider (optional) ----------------------------------------------
GEMINI_API_KEY=
