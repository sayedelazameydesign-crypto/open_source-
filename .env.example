# WaAPI credentials are read by the server only; never put real secrets here.
WAAPI_BEARER_TOKEN=
WAAPI_INSTANCE_ID=
WAAPI_NOTIFY_CHAT_ID=

# Generate a separate 32+ character URL secret for the WaAPI webhook callback.
# Optional additional header authentication (configure the same name/value in WaAPI).
WAAPI_WEBHOOK_PATH_SECRET=
WAAPI_WEBHOOK_HEADER_NAME=
WAAPI_WEBHOOK_HEADER_VALUE=

# Keep disabled until server credentials, callback URL, and webhook settings are verified.
CELA_WAAPI_ENABLE=0

# --- CELA.PRO (cela_pro_app.py) provider configuration ---------------------
# Template only: copy to .env (gitignored) and fill values there. Never commit a
# real key. The UI shows whether a key is *set*; only the smoke test («اختبار
# اتصال المزوّد») tells you whether the provider actually answers.
CELA_DEFAULT_PROVIDER=Groq

# Each provider reads <NAME>_API_KEY, <NAME>_MODEL, <NAME>_BASE_URL and the
# optional <NAME>_REQUEST_EXTRA_JSON (a JSON object merged into the request body
# for provider- or relay-specific parameters).
# os_server's free-tier provider (Render) reads GEMINI_MODEL and GEMINI_BASE_URL too;
# blank or unset uses the built-in defaults (gemini-2.5-flash, Google's endpoint).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_REQUEST_EXTRA_JSON=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
GEMINI_REQUEST_EXTRA_JSON=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_REQUEST_EXTRA_JSON=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=
KIMI_REQUEST_EXTRA_JSON=

# Ollama is local and needs no key (OLLAMA_API_KEY is optional).
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=
OLLAMA_REQUEST_EXTRA_JSON=

# Relay example — any OpenAI-compatible endpoint (e.g. a Modal server exposing
# moonshotai/Kimi-K3). BASE_URL ends in /v1; the app appends /chat/completions.
# The bearer token is the composite "<TOKEN_ID>.<TOKEN_SECRET>" pair.
#KIMI_BASE_URL=https://<workspace>--ep-<endpoint>.<region>.modal.direct/v1
#KIMI_MODEL=moonshotai/Kimi-K3
#KIMI_API_KEY=<TOKEN_ID>.<TOKEN_SECRET>
#KIMI_REQUEST_EXTRA_JSON={"reasoning_effort": "none"}

# Protects the public Gradio link (share=True) from consuming your API quota.
GRADIO_USERNAME=
GRADIO_PASSWORD=

# --- Web BFF operator access gate (recommended for any public URL) -----------
# When set, every /api/backend/* request must present a valid operator proof:
# a signed, expiring HttpOnly cookie from POST /api/access, or the secret
# itself in an X-Celia-Access header for curl/automation. The cookie never
# carries the secret. Generate with the same pattern as the API tokens.
# Vercel تنبيه: Next.js على Vercel يعمل دائماً بـ NODE_ENV=production، فغياب
# هذا السر يعني فشلاً مغلقاً — كل /api/backend/* يعيد 503 access_gate_unconfigured
# والواجهة المنشورة لا تصل إلى الـbackend إطلاقاً. على Vercel اجعله إلزامياً.
CELA_WEB_ACCESS_SECRET=
# Production safety: with no secret, production and unknown environments fail
# closed; only NODE_ENV=development|test stays open automatically. Set =1 to
# require the secret in any environment, or =0 only to intentionally open it.
# على Vercel ضعه =1 صراحةً لتوثيق أن البوابة مطلوبة (vercel_gate_required_unset).
CELA_WEB_GATE_REQUIRED=

# --- Celia.sh — Mission OS (os_server + packages/web) -----------------------
# Keep all tokens server-side only (never prefix with NEXT_PUBLIC_).
CELA_API_TOKEN=
CELA_PRIVATE_API_TOKEN=
CELA_BACKEND_URL=http://127.0.0.1:8080

# Durable run & artifact storage:
# - Local: sqlite:///./cela_runs.db
# - Render Free + Supabase Postgres Free: postgresql://user:pass@host:5432/postgres
CELA_RUN_STORE_URL=

# Optional outbound URL allow/deny lists for inspect_public_url:
CELA_MISSION_ALLOW_HOSTS=
CELA_MISSION_DENY_HOSTS=

# Optional Activepieces webhook connector (HMAC-SHA256 + free-tier quota guard):
CELA_ACTIVEPIECES_WEBHOOK_URL=
CELA_ACTIVEPIECES_WEBHOOK_SECRET=
CELA_ACTIVEPIECES_DAILY_LIMIT=100
CELA_ACTIVEPIECES_MONTHLY_LIMIT=1000

