# WaAPI credentials are read by the server only; never put real secrets here.
WAAPI_BEARER_TOKEN=
WAAPI_INSTANCE_ID=
WAAPI_NOTIFY_CHAT_ID=

# Generate a separate 32+ character URL secret for the WaAPI webhook callback.
# Optional additional header authentication (configure the same name/value in WaAPI).
WAAPI_WEBHOOK_PATH_SECRET=
WAAPI_WEBHOOK_HEADER_NAME=
WAAPI_WEBHOOK_HEADER_VALUE=

# Keep disabled until server credentials, callback URL, and webhook settings are verified.
CELA_WAAPI_ENABLE=0
