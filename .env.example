# Template for the variables an operator normally sets. It is NOT the full
# reference: every variable the code reads — with its default and whether it
# widens permissions — is documented in docs/CONFIGURATION.md.
# Copy to .env (gitignored) and fill values there; never commit a real secret.

# WaAPI credentials are read by the server only; never put real secrets here.
WAAPI_BEARER_TOKEN=
WAAPI_INSTANCE_ID=
WAAPI_NOTIFY_CHAT_ID=

# Generate a separate 32+ character URL secret for the WaAPI webhook callback.
# Optional additional header authentication (configure the same name/value in WaAPI).
WAAPI_WEBHOOK_PATH_SECRET=
WAAPI_WEBHOOK_HEADER_NAME=
WAAPI_WEBHOOK_HEADER_VALUE=

# Keep disabled until server credentials, callback URL, and webhook settings are verified.
CELA_WAAPI_ENABLE=0

# --- CELA.PRO (cela_pro_app.py) provider configuration ---------------------
# Template only: copy to .env (gitignored) and fill values there. Never commit a
# real key. The UI shows whether a key is *set*; only the smoke test («اختبار
# اتصال المزوّد») tells you whether the provider actually answers.
CELA_DEFAULT_PROVIDER=Groq

# Each provider reads <NAME>_API_KEY, <NAME>_MODEL, <NAME>_BASE_URL and the
# optional <NAME>_REQUEST_EXTRA_JSON (a JSON object merged into the request body
# for provider- or relay-specific parameters).
# os_server's free-tier provider (Render) reads GEMINI_MODEL and GEMINI_BASE_URL too;
# blank or unset uses the built-in defaults (gemini-2.5-flash, Google's endpoint).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GROQ_REQUEST_EXTRA_JSON=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
GEMINI_REQUEST_EXTRA_JSON=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_REQUEST_EXTRA_JSON=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=
KIMI_REQUEST_EXTRA_JSON=

# Ollama is local and needs no key (OLLAMA_API_KEY is optional).
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=
OLLAMA_REQUEST_EXTRA_JSON=

# Relay example — any OpenAI-compatible endpoint (e.g. a Modal server exposing
# moonshotai/Kimi-K3). BASE_URL ends in /v1; the app appends /chat/completions.
# The bearer token is the composite "<TOKEN_ID>.<TOKEN_SECRET>" pair.
#KIMI_BASE_URL=https://<workspace>--ep-<endpoint>.<region>.modal.direct/v1
#KIMI_MODEL=moonshotai/Kimi-K3
#KIMI_API_KEY=<TOKEN_ID>.<TOKEN_SECRET>
#KIMI_REQUEST_EXTRA_JSON={"reasoning_effort": "none"}

# Protects the public Gradio link (share=True) from consuming your API quota.
GRADIO_USERNAME=
GRADIO_PASSWORD=

# CELA.PRO local research/skill library. Use the same store URLs in the main API
# (os_server / CLI) to share indexed papers and imported skills across interfaces.
# Unset store URLs default to SQLite files inside CELA_PRO_DATA_DIR.
CELA_PRO_DATA_DIR=~/.local/share/cela-pro
CELA_KNOW_STORE_URL=
CELA_SKILL_STORE_URL=
# Required for CELA.PRO write actions (adding papers, importing SKILL.md); without
# it the library is read-only. Choose a separate long random value. When
# GRADIO_USERNAME/GRADIO_PASSWORD are unset it also guards the public Gradio link:
# log in with username `operator` and this value as the password.
CELA_PRO_ADMIN_TOKEN=

# --- Web BFF operator access gate (recommended for any public URL) -----------
# When set, every /api/backend/* request must present a valid operator proof:
# a signed, expiring HttpOnly cookie from POST /api/access, or the secret
# itself in an X-Celia-Access header for curl/automation. The cookie never
# carries the secret. Generate with the same pattern as the API tokens.
# Vercel تنبيه: Next.js على Vercel يعمل دائماً بـ NODE_ENV=production، فغياب
# هذا السر يعني فشلاً مغلقاً — كل /api/backend/* يعيد 503 access_gate_unconfigured
# والواجهة المنشورة لا تصل إلى الـbackend إطلاقاً. على Vercel اجعله إلزامياً
# في Production وPreview معاً (Dashboard أو vercel deploy --env)، وكل تعديل يتطلب نشراً جديداً.
CELA_WEB_ACCESS_SECRET=
# Production safety: with no secret, production and unknown environments fail
# closed; only NODE_ENV=development|test stays open automatically. Set =1 to
# require the secret in any environment, or =0 only to intentionally open it.
# على Vercel ضعه =1 صراحةً لتوثيق أن البوابة مطلوبة (vercel_gate_required_unset).
CELA_WEB_GATE_REQUIRED=

# --- Celia.sh — Mission OS (os_server + packages/web) -----------------------
# Keep all tokens server-side only (never prefix with NEXT_PUBLIC_).
CELA_API_TOKEN=
CELA_PRIVATE_API_TOKEN=
CELA_BACKEND_URL=http://127.0.0.1:8080

# Durable run & artifact storage:
# - Local: sqlite:///./cela_runs.db
# - Render Free + Supabase Postgres Free: postgresql://user:pass@host:5432/postgres
CELA_RUN_STORE_URL=

# Public API schema (Swagger UI + OpenAPI). Default 1 keeps the post-deploy
# `/docs => 200` smoke signal used by docs/NO_CARD_DEPLOY_VERIFIED.md. Set 0 on
# an internet-exposed deployment you do not want to hand a full route map to:
# /docs, /redoc and /openapi.json then answer 404 while the API is unchanged.
CELA_PUBLIC_DOCS=1

# Run-outcome ledger (one JSONL line per run). Default ./.cela/ledger.jsonl;
# `off` disables it. Being a container path, `off` is the safe choice when the
# filesystem is read-only:
CELA_LEDGER_PATH=

# Optional outbound URL allow/deny lists for inspect_public_url:
CELA_MISSION_ALLOW_HOSTS=
CELA_MISSION_DENY_HOSTS=

# Optional Activepieces webhook connector (HMAC-SHA256 + free-tier quota guard):
CELA_ACTIVEPIECES_WEBHOOK_URL=
CELA_ACTIVEPIECES_WEBHOOK_SECRET=
CELA_ACTIVEPIECES_DAILY_LIMIT=100
CELA_ACTIVEPIECES_MONTHLY_LIMIT=1000

# Optional AI Indigo external REST API v1 integration (ADR-0021):
# Completely independent of core C5/C6 services; leave CELA_INDIGO_ENABLE=0 unless
# explicitly connecting /api/indigo/* and /cela/v1/indigo/* to aiindigo.com.
CELA_INDIGO_ENABLE=0
INDIGO_API_KEY=

# --- Embedding backends (ADR-0022 / ADR-0023) — off unless you switch it on ---
# Unset = `off`: retrieval stays lexical, no embedding code path runs, and a
# half-embedded corpus cannot exist. Values: off | local | model | provider.
CELA_EMBED_BACKEND=
# Dense width. `local` defaults to 512; `provider` REQUIRES it (the space tag
# model@dim must exist before the first byte leaves, not after the first reply);
# leave it empty for `model`, which reports its own dimension.
CELA_EMBED_DIM=
# `model` only: sentence-transformers checkpoint (needs the [ai] extra).
CELA_EMBED_MODEL=
# `model` only: 1 allows the first use to download weights from Hugging Face.
# Default 0 = cached weights only; a cache miss is an error, not a download.
CELA_EMBED_ALLOW_DOWNLOAD=0
# `provider` only — fail-closed on purpose:
#  * CELA_EMBED_ALLOW_PROVIDER=1 is the explicit consent to send corpus text out;
#  * CELA_EMBED_ALLOW_HOSTS is a comma-separated host[:port] allow-list (HTTPS
#    only, no wildcards, no IP literals, scoped to tool="embeddings");
#  * the URL must be https:// with no credentials and no query string;
#  * redirects are not followed, so the bearer token never leaves that origin.
CELA_EMBED_ALLOW_PROVIDER=0
CELA_EMBED_ALLOW_HOSTS=
CELA_EMBED_PROVIDER_BASE_URL=
CELA_EMBED_PROVIDER_MODEL=
# NAME of the variable that holds the bearer token (e.g. EMBED_API_KEY) — not
# the token itself. Read at request time and never stored on the backend object.
CELA_EMBED_API_KEY_ENV=
# 1 sends {"dimensions": ...} (OpenAI-specific; some compatible servers reject it).
CELA_EMBED_PROVIDER_SEND_DIMENSIONS=0
# Per-input character cap before a tokenizer or a paid endpoint (default 8000).
# Truncation is counted and reported, never silent.
CELA_EMBED_MAX_CHARS=8000
