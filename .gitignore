# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local run-outcome ledger (default $CELA_LEDGER_PATH is ./.cela/ledger.jsonl)
.cela/

# Secrets — never commit these
.env
.env.*
*.pem
*.key

# Local web test compilation and verification scratch files
.cache/
